{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Emits the published JavaScript and declarations: src/index.ts -> dist/index.{js,d.ts}.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": [],
    "noEmit": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}

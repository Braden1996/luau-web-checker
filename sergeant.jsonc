{
  "$schema": "./.sergeant/schema.json",
  "plugins": ["ts", "bun", "oxlint", "astro", "actionlint", "zizmor", "shellcheck", "secrets"],
  "packages": ["packages/libraries/*/*/*", "packages/runtimes/*"],
  "typescript": {
    "tsconfig": "repo",
    "strictness": "enforce",
    "checker": "tsc",
  },
  "cache": {
    "untrackable": "degrade",
  },
  "boundaries": {
    "noUnitCycles": true,
  },
  "tasks": {
    "wasm-assets": {
      "cache": true,
      "run": ["bun", "packages/libraries/ts/dom/luau-web-checker/scripts/copy-types.effect.ts", "wasm"],
      "inputs": [
        "packages/libraries/ts/dom/luau-web-checker/wasm/**",
        "packages/libraries/ts/dom/luau-web-checker/scripts/copy-types.effect.ts",
        "packages/libraries/ts/dom/luau-web-checker/types/luau-checker.d.mts",
        "mise.toml",
        "mise.lock",
        ".build/wasm-artifacts/LICENSE-luau.txt",
        ".build/wasm-artifacts/luau-checker.wasm",
        ".build/wasm-artifacts/luau-checker.mjs",
        "packages/libraries/ts/dom/luau-web-checker/scripts/build-wasm.effect.ts",
        "packages/libraries/ts/dom/luau-web-checker/scripts/wasm-inputs.ts",
        ".build/wasm-artifacts/inputs.sha256",
      ],
      "outputs": ["LICENSE-luau.txt", "luau-checker.wasm", "luau-checker.mjs", "luau-checker.d.mts"],
      "description": "Cache the pinned Emscripten build artifacts for the npm package",
    },
    "library-dist": {
      "cache": true,
      "run": ["bun", "packages/libraries/ts/dom/luau-web-checker/scripts/copy-types.effect.ts", "dist"],
      "dependsOn": ["wasm-assets"],
      "inputs": [
        "packages/libraries/ts/dom/luau-web-checker/scripts/copy-types.effect.ts",
        "packages/libraries/ts/dom/luau-web-checker/package.json",
        "packages/libraries/ts/dom/luau-web-checker/tsconfig.json",
        "packages/libraries/ts/dom/luau-web-checker/tsconfig.src.json",
        "tsconfig.base.json",
        "packages/libraries/ts/dom/luau-web-checker/src/**",
        "packages/libraries/ts/dom/luau-web-checker/types/**",
        "packages/libraries/ts/dom/luau-web-checker/scripts/wasm-inputs.ts",
      ],
      "outputs": ["*.js", "*.d.ts", "luau-checker.d.mts", "luau-checker.mjs", "luau-checker.wasm", "LICENSE-luau.txt"],
      "into": "packages/libraries/ts/dom/luau-web-checker/dist",
      "tools": ["node"],
    },
    "pack": {
      "check": true,
      "cache": true,
      "run": ["bun", "packages/libraries/ts/dom/luau-web-checker/scripts/check-pack.effect.ts"],
      "dependsOn": ["library-dist"],
      "inputs": [
        "packages/libraries/ts/dom/luau-web-checker/package.json",
        "packages/libraries/ts/dom/luau-web-checker/LICENSE",
        "packages/libraries/ts/dom/luau-web-checker/README.md",
        "packages/libraries/ts/dom/luau-web-checker/scripts/check-pack.effect.ts",
        "package.json",
        "packages/libraries/ts/dom/luau-web-checker/types/luau-checker.d.mts",
      ],
    },
    "docs-content": {
      "cache": true,
      "run": ["bun", "packages/runtimes/docs/scripts/sync-docs.effect.ts"],
      "inputs": ["CHANGELOG.md", "CONTRIBUTING.md", "packages/runtimes/docs/scripts/sync-docs.effect.ts"],
      "outputs": ["changelog.md", "contributing.md"],
      "into": "packages/runtimes/docs/src/content/docs/project/generated",
    },
    "docs-worker-types": {
      "check": true,
      "cache": true,
      "run": ["node", "node_modules/typescript/bin/tsc", "-p", "packages/runtimes/docs/tsconfig.worker.json"],
      "dependsOn": ["library-dist"],
      "inputs": [
        "packages/runtimes/docs/package.json",
        "packages/runtimes/docs/tsconfig.worker.json",
        "packages/runtimes/docs/src/**",
        "packages/runtimes/docs/types/**",
        "packages/runtimes/docs/astro.config.ts",
        "packages/runtimes/docs/ec.config.mjs",
        "packages/runtimes/docs/scripts/**",
        "tsconfig.base.json",
      ],
    },
    "docs-config-types": {
      "check": true,
      "cache": true,
      "run": ["node", "node_modules/typescript/bin/tsc", "-p", "packages/runtimes/docs/tsconfig.ec.json"],
      "dependsOn": ["library-dist"],
      "inputs": [
        "packages/runtimes/docs/package.json",
        "packages/runtimes/docs/tsconfig.ec.json",
        "packages/runtimes/docs/src/**",
        "packages/runtimes/docs/types/**",
        "packages/runtimes/docs/astro.config.ts",
        "packages/runtimes/docs/ec.config.mjs",
        "packages/runtimes/docs/scripts/**",
        "tsconfig.base.json",
      ],
    },
  },
}
